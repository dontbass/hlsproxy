config hlsproxy 'main'
	option enabled '1'
	option port '8888'
	# auto — подстройка по каждому каналу (профили, потоки, авто-пауза); advise — только советы; off — фиксированно
	option mode 'auto'
	# отставание от эфира по умолчанию для нового канала, сек
	option delay '60'
	# потолок защиты, сек (RAM: ≈ битрейт/8 × секунды)
	option max_delay '180'
	# макс. длительность одной авто-паузы, сек (0 — не делать)
	option max_pause '40'
	# сегментов плееру на старте
	option start_segs '3'
	# сегментов в плейлисте для плеера (минимум; растёт сам при необходимости)
	option window '8'
	# начальное число параллельных загрузок на канал
	option concurrency '2'
	# 1 = оставить все качества в master-плейлисте (по умолчанию только лучшее)
	option all_variants '0'
	# журнал событий и история сеансов для панели (/tmp — в RAM, пропадает при перезагрузке;
	# для хранения между перезагрузками укажите USB/флеш, например /mnt/usb/hlsproxy). Пусто — выкл.
	option log_dir '/tmp/hlsproxy-log'
	# User-Agent к провайдеру (пусто = как у плеера)
	option ua ''
