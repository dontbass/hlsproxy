config hlsproxy 'main'
	option enabled '1'
	option port '8888'
	# отставание от эфира провайдера, сек (больше = устойчивее к провалам, ограничено окном плейлиста провайдера)
	option delay '60'
	# сегментов сразу отдаётся плееру на старте (его собственный буфер)
	option start_segs '3'
	# сегментов в плейлисте для плеера
	option window '8'
	# параллельных загрузок на канал
	option concurrency '2'
	# 1 = оставить все качества в master-плейлисте (по умолчанию только лучшее)
	option all_variants '0'
	# User-Agent к провайдеру (пусто = как у плеера)
	option ua ''
