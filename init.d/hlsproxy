#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/hlsproxy

# Правило файрвола для доступа извне: создаётся при wan_access=1 и заданном ключе.
sync_firewall() {
	local want port key cur
	want=$(uci -q get hlsproxy.main.wan_access)
	port=$(uci -q get hlsproxy.main.port); port=${port:-8888}
	key=$(uci -q get hlsproxy.main.access_key)
	cur="$(uci -q get firewall.hlsproxy)/$(uci -q get firewall.hlsproxy.dest_port)"
	if [ "$want" = "1" ] && [ -n "$key" ]; then
		[ "$cur" = "rule/$port" ] && return 0
		uci -q delete firewall.hlsproxy
		uci set firewall.hlsproxy=rule
		uci set firewall.hlsproxy.name='Allow-HLSProxy'
		uci set firewall.hlsproxy.src='wan'
		uci set firewall.hlsproxy.proto='tcp'
		uci set firewall.hlsproxy.dest_port="$port"
		uci set firewall.hlsproxy.target='ACCEPT'
	else
		[ "$cur" = "/" ] && return 0
		uci -q delete firewall.hlsproxy
	fi
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
}

start_service() {
	config_load hlsproxy
	local enabled port mode delay max_delay max_pause start_segs window concurrency all_variants ua log_dir access_key ext_ui subs subs_default subs_lang subs_proxy asr_key llm_key
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0
	config_get port main port 8888
	config_get mode main mode auto
	config_get delay main delay 60
	config_get max_delay main max_delay 180
	config_get max_pause main max_pause 40
	config_get start_segs main start_segs 3
	config_get window main window 8
	config_get concurrency main concurrency 2
	config_get_bool all_variants main all_variants 0
	config_get ua main ua ""
	config_get log_dir main log_dir /tmp/hlsproxy-log
	config_get access_key main access_key ""
	config_get_bool ext_ui main ext_ui 0
	config_get_bool subs main subs 0
	config_get_bool subs_default main subs_default 0
	config_get subs_lang main subs_lang ru
	config_get subs_proxy main subs_proxy ""
	config_get asr_key main asr_key ""
	config_get llm_key main llm_key ""
	sync_firewall

	mkdir -p /etc/hlsproxy
	procd_open_instance
	procd_set_param command $PROG -listen ":$port" -mode "$mode" -delay "$delay" -max-delay "$max_delay" \
		-max-pause "$max_pause" -start-segs "$start_segs" -window "$window" -concurrency "$concurrency" \
		-cache /tmp/hls_cache -profiles /etc/hlsproxy/profiles.json -log-dir "$log_dir"
	[ "$all_variants" = "1" ] && procd_append_param command -all-variants
	[ -n "$ua" ] && procd_append_param command -ua "$ua"
	[ -n "$access_key" ] && procd_append_param command -access-key "$access_key"
	[ "$ext_ui" = "1" ] && procd_append_param command -ext-ui
	if [ "$subs" = "1" ]; then
		procd_append_param command -subs -subs-lang "$subs_lang"
		[ "$subs_default" = "1" ] && procd_append_param command -subs-default
		[ -n "$subs_proxy" ] && procd_append_param command -subs-proxy "$subs_proxy"
		# keys via environment: not visible in ps
		procd_set_param env HLSPROXY_ASR_KEY="$asr_key" HLSPROXY_LLM_KEY="$llm_key"
	fi
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "hlsproxy"
}
